{
  // Lanzadores del proyecto. Para la demo: "BFF + App" levanta todo con F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (dev · teléfono USB)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/super_app",
      "program": "lib/main.dart",
      // Redirige el puerto 3000 del teléfono al PC antes de lanzar la app.
      "preLaunchTask": "adb reverse 3000",
      "toolArgs": ["--dart-define=ENV=dev"]
    },
    {
      "name": "App (profile · medir rendimiento)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/super_app",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "preLaunchTask": "adb reverse 3000",
      "toolArgs": ["--dart-define=ENV=dev"]
    },
    {
      "name": "BFF (Node · watch)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "BFF + App",
      "configurations": ["BFF (Node · watch)", "App (dev · teléfono USB)"],
      "stopAll": true
    }
  ]
}
