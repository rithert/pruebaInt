NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/bff.db

# Obligatorios en producción (mínimo 32 caracteres para JWT_SECRET).
JWT_SECRET=
ADMIN_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_PER_MINUTE=10
# Chaos testing (/admin/chaos). Por defecto activo salvo con NODE_ENV=production.
CHAOS_ENABLED=true
# Orígenes de mini apps permitidos por CORS (separados por coma).
MINI_APP_ORIGINS=http://localhost:3100
# 0 desactiva el motor de actividad.
ACTIVITY_INTERVAL_MS=60000
